# Copy to .env and fill in. Never commit .env.
# FRED: free key from https://fred.stlouisfed.org/docs/api/api_key.html
# Without a key the pipeline falls back to FRED's public fredgraph.csv download.
FRED_API_KEY=
# Step 3 (sentiment) — Reddit "script" app credentials: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aggregate-a/0.1 by <your_reddit_username>
# Optional, paid: X/Twitter API v2 bearer token. Module is skipped if empty.
X_BEARER_TOKEN=
